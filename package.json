{
  "name": "tommie-circuit-workbook",
  "version": "0.0.0",
  "private": true,
  "description": "回路・Analog Discovery・NanoVNA の実験帳。回路図と実体配線図を tommie-fence のフェンスで書く",
  "license": "CC-BY-4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "toc": "node scripts/toc.mjs",
    "render": "node scripts/render.mjs",
    "lint": "markdownlint '**/*.md' --ignore node_modules --ignore out",
    "test": "node --test scripts/*.test.mjs",
    "all": "npm test && npm run lint && npm run check"
  },
  "devDependencies": {
    "breadboard-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/breadboard-fence-v0.11.0/breadboard-fence-0.11.0.tgz",
    "circuit-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/circuit-fence-v0.9.4/circuit-fence-0.9.4.tgz",
    "markdownlint-cli": "^0.49.1",
    "perfboard-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/perfboard-fence-v0.9.0/perfboard-fence-0.9.0.tgz",
    "yaml": "^2.9.0"
  }
}
