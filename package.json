    "markdownlint-cli": "^0.49.1",
    "perfboard-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/perfboard-fence-v0.11.1/perfboard-fence-0.11.1.tgz",
    "subset-font": "^2.9.0",
    "vna-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/vna-fence-v0.1.1/vna-fence-0.1.1.tgz",
    "yaml": "^2.9.0"
  }
}
