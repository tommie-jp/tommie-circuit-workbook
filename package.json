{
  "name": "tommie-circuit-workbook",
  "version": "0.0.0",
  "private": true,
  "description": "回路・Analog Discovery・NanoVNA・電験三種の実験帳。回路図・実体配線図・NanoVNA の画面を tommie-fence のフェンスで書く",
  "license": "CC-BY-4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "toc": "node scripts/toc.mjs",
    "render": "node scripts/render.mjs",
    "lint": "markdownlint '**/*.md' --ignore node_modules --ignore out",
    "test": "node --test scripts/*.test.mjs",
    "all": "npm test && npm run lint && npm run check"
  },
  "devDependencies": {
    "breadboard-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/breadboard-fence-v0.13.1/breadboard-fence-0.13.1.tgz",
