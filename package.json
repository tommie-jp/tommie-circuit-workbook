{
  "name": "tommie-circuit-workbook",
  "version": "0.0.0",
  "private": true,
  "description": "回路・Analog Discovery・NanoVNA・電験三種の実験帳。回路図・実体配線図・NanoVNA・オシロスコープ・ロジックアナライザの画面・グラフ付きの実験帳",
  "license": "CC-BY-4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "validate-entry": "node scripts/validate-entry.mjs",
    "toc": "node scripts/toc.mjs",
    "render": "node scripts/render.mjs",
    "figures": "node scripts/figures.mjs",
    "parity": "node scripts/netlist-parity.mjs",
    "audit": "node scripts/audit-figures.mjs",
    "lint": "markdownlint '**/*.md' --ignore node_modules --ignore out",
    "test": "node --test scripts/*.test.mjs",
    "all": "npm test && npm run lint && npm run check && npm run parity && npm run pico:test",
    "pico:extract": "node scripts/pico-extract.mjs",
    "pico:host": "node tests/pico/host/run.mjs",
    "pico:upy": "python3 -I tests/pico/upy/run.py",
    "pico:pio": "python3 -I tests/pico/pio/run.py",
    "pico:test": "npm run pico:extract && npm run pico:host && npm run pico:upy && npm run pico:pio"
  },
  "devDependencies": {
    "breadboard-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/breadboard-fence-v0.43.0/breadboard-fence-0.43.0.tgz",
    "circuit-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/circuit-fence-v0.38.1/circuit-fence-0.38.1.tgz",
    "copper-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/copper-fence-v0.10.0/copper-fence-0.10.0.tgz",
    "graph-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/graph-fence-v0.3.0/graph-fence-0.3.0.tgz",
    "logic-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/logic-fence-v0.2.0/logic-fence-0.2.0.tgz",
    "markdownlint-cli": "^0.49.1",
    "perfboard-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/perfboard-fence-v0.42.0/perfboard-fence-0.42.0.tgz",
    "scope-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/scope-fence-v0.7.0/scope-fence-0.7.0.tgz",
    "spectrum-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/spectrum-fence-v0.5.0/spectrum-fence-0.5.0.tgz",
    "subset-font": "^2.9.0",
    "vna-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/vna-fence-v0.8.0/vna-fence-0.8.0.tgz",
    "yaml": "^2.9.0"
  }
}
