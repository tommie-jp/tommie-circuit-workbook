    "markdownlint-cli": "^0.49.1",
    "perfboard-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/perfboard-fence-v0.16.0/perfboard-fence-0.16.0.tgz",
    "scope-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/scope-fence-v0.5.0/scope-fence-0.5.0.tgz",
    "spectrum-fence": "https://github.com/tommie-jp/tommie-fence/releases/download/spectrum-fence-v0.2.0/spectrum-fence-0.2.0.tgz",
    "subset-font": "^2.9.0",
