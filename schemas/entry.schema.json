{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tommie-circuit-workbook topic front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["book", "chapter", "id", "title", "tier", "source"],
  "properties": {
    "book": {
      "type": "string",
      "enum": ["circuits", "analog-discovery", "nanovna", "denken", "etc", "fpga"]
    },
    "chapter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "integer",
      "enum": [50, 100, 200, 300]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "oneOf": [
        { "type": "string", "enum": ["BB", "PF", "CB", "—"] },
        { "type": "array", "items": { "type": "string", "enum": ["BB", "PF", "CB", "—"] } }
      ]
    },
    "device": {
      "type": "string",
      "enum": ["AD2", "AD3", "LV64", "H4", "V2", "SA", "SIM", "WEB", "PICO", "FPGA"]
    },
    "tools": {
      "type": "array",
      "items": { "type": "string", "enum": ["AD", "VNA", "SA", "scope", "logic"] }
    },
    "era": {
      "type": "string",
      "enum": ["古", "今", "古/今"]
    },
    "seen": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "人が目で確認した日 (YYYY-MM-DD)"
    },
    "reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Claude (Fable) で確認した日 (YYYY-MM-DD)"
    }
  }
}
