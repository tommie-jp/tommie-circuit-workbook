Vs_1 s_1 0 AC 1
Rs_1 s_1 n0_1 50
C1_0_1 n0_1 0 1.890000000e-10
L2_0_1 n0_1 n1_1 3.630000000e-07 Rser=1u
C3_0_1 n1_1 0 2.835000000e-10
L4_0_1 n1_1 n2_1 3.630000000e-07 Rser=1u
C5_0_1 n2_1 0 1.890000000e-10
RL_1 n2_1 0 50
.meas AC a1_0 FIND V(n0_1) AT 10000000
.meas AC c1_0 FIND V(n2_1) AT 10000000
.meas AC a1_1 FIND V(n0_1) AT 24800000
.meas AC c1_1 FIND V(n2_1) AT 24800000
.meas AC a1_2 FIND V(n0_1) AT 28000000
.meas AC c1_2 FIND V(n2_1) AT 28000000
.meas AC a1_3 FIND V(n0_1) AT 35000000
.meas AC c1_3 FIND V(n2_1) AT 35000000
* 図5: shunt C 189p / series L 363n / shunt C 256.5p / series L 297n / shunt C 189p
Vs_2 s_2 0 AC 1
Rs_2 s_2 n0_2 50
C1_0_2 n0_2 0 1.890000000e-10
L2_0_2 n0_2 n1_2 3.630000000e-07 Rser=1u
C3_0_2 n1_2 0 2.565000000e-10
L4_0_2 n1_2 n2_2 2.970000000e-07 Rser=1u
C5_0_2 n2_2 0 1.890000000e-10
RL_2 n2_2 0 50
.meas AC a2_0 FIND V(n0_2) AT 10000000
.meas AC c2_0 FIND V(n2_2) AT 10000000
.meas AC a2_1 FIND V(n0_2) AT 24800000
.meas AC c2_1 FIND V(n2_2) AT 24800000
.meas AC a2_2 FIND V(n0_2) AT 28000000
.meas AC c2_2 FIND V(n2_2) AT 28000000
.meas AC a2_3 FIND V(n0_2) AT 35000000
.meas AC c2_3 FIND V(n2_2) AT 35000000
.end
