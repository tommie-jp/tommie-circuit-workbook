Vs_6 s_6 0 AC 1
Rs_6 s_6 n0_6 50
C1_0_6 n0_6 n1_6 3.300000000e-09
Rend_6 n1_6 0 1u
.meas AC a6_0 FIND V(n0_6) AT 1000000
* 図10: series R 51 / series L 8.2u / short
Vs_7 s_7 0 AC 1
Rs_7 s_7 n0_7 50
R1_0_7 n0_7 n1_7 5.100000000e+01
L2_0_7 n1_7 n2_7 8.200000000e-06 Rser=1u
Rend_7 n2_7 0 1u
.meas AC a7_0 FIND V(n0_7) AT 1000000
* 図11: shunt C 2.5p / open
Vs_8 s_8 0 AC 1
Rs_8 s_8 n0_8 50
C1_0_8 n0_8 0 2.500000000e-12
.meas AC a8_0 FIND V(n0_8) AT 3000000
.meas AC a8_1 FIND V(n0_8) AT 30000000
* 図12: series L 43n / short
Vs_9 s_9 0 AC 1
Rs_9 s_9 n0_9 50
L1_0_9 n0_9 n1_9 4.300000000e-08 Rser=1u
Rend_9 n1_9 0 1u
