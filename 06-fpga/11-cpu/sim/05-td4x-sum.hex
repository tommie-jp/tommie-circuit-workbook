// 05-td4x-sum.hex  5+4+3+2+1 を A に足して OUT に出す (11-5、手で書いた機械語)
30 // 0: MOV A,0
75 // 1: MOV B,5
A0 // 2: ADD A,B      (足した命令)
5F // 3: ADD B,15     B を 1 減らす。0 になればゼロフラグが立つ
C6 // 4: JZ  6        (足した命令)
F2 // 5: JMP 2
80 // 6: OUT A        (足した命令)
F7 // 7: JMP 7        ここで止まる
00 // 8
00 // 9
00 // 10
00 // 11
00 // 12
00 // 13
00 // 14
00 // 15
