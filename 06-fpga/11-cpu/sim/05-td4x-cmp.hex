// 05-td4x-cmp.hex  IN が 5 以上なら OUT に 1、5 より小さければ 0 を出す (11-5、手で書いた機械語)
20 // 0: IN  A
75 // 1: MOV B,5
D0 // 2: SUB A,B      (足した命令) A >= B なら桁上げが立つ (借りが無い)
E6 // 3: JNC 6        借りが有った (A < 5)
B1 // 4: OUT 1
F0 // 5: JMP 0
B0 // 6: OUT 0
F0 // 7: JMP 0
00 // 8
00 // 9
00 // 10
00 // 11
00 // 12
00 // 13
00 // 14
00 // 15
